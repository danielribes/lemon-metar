{
  "name": "lemon-metar",
  "version": "0.3.0",
  "description": "METAR/SPECI parser that returns JSON and a multilingual text description of each element",
  "type": "module",
  "exports": {
    ".": "./dist/lemon-metar.min.js",
    "./airports": "./dist/airports.min.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=95 --test-coverage-branches=90 \"test/**/*.test.js\"",
    "test:dist": "node --test \"test-dist/**/*.test.js\"",
    "build": "npm run build:lib && npm run build:airports",
    "build:lib": "esbuild src/index.js --bundle --minify --format=esm --target=es2022 --sourcemap --outfile=dist/lemon-metar.min.js",
    "build:airports": "esbuild src/airports/index.js --bundle --minify --format=esm --target=es2022 --outfile=dist/airports.min.js",
    "airports": "node scripts/update-airports.js",
    "verify": "npm run test:coverage && npm run build && npm run test:dist"
  },
  "keywords": [
    "metar",
    "speci",
    "aviation",
    "weather",
    "parser"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
